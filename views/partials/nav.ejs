<nav class="navbar navbar-expand-lg navbar-custom">
  <div class="container">
    <a class="navbar-brand-gradient" href="/">
      <i class="bi bi-journal-richtext"></i> Blogify
    </a>
    
    <button class="navbar-toggler text-white border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
      <i class="bi bi-list fs-2"></i>
    </button>
    
    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav ms-auto align-items-center gap-2 mt-3 mt-lg-0">
        <li class="nav-item">
          <a class="nav-link nav-link-custom active" href="/"><i class="bi bi-house-door me-1"></i> Home</a>
        </li>

        <% if (locals.user) { %>
          <li class="nav-item">
            <a class="nav-link nav-link-custom" href="/blog/add-new"><i class="bi bi-pencil-square me-1"></i> Write Blog</a>
          </li>

          <li class="nav-item dropdown ms-lg-2">
            <a class="nav-link nav-link-custom dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <div class="author-avatar-placeholder" style="width: 28px; height: 28px; font-size: 0.75rem;">
                <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U' %>
              </div>
              <span><%= user.fullName %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark style-dropdown shadow-lg border-0" style="background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.1) !important;">
              <li><a class="dropdown-item py-2 text-danger" href="/user/logout"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
            </ul>
          </li>
        <% } else { %> 
          <li class="nav-item">
            <a class="btn btn-outline-custom me-2" href="/user/signin"><i class="bi bi-box-arrow-in-right me-1"></i> Sign In</a>
          </li>
          <li class="nav-item">
            <a class="btn btn-primary-gradient" href="/user/signup"><i class="bi bi-person-plus me-1"></i> Create Account</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<% if (locals.error) { %>
  <div class="container mt-4">
    <div class="alert alert-danger border-0 text-white shadow-sm d-flex align-items-center gap-2" role="alert" style="background: rgba(225, 29, 72, 0.85); backdrop-filter: blur(10px); border-radius: 14px;">
      <i class="bi bi-exclamation-triangle-fill fs-5"></i>
      <div><%= locals.error %></div>
    </div>
  </div>
<% } %>