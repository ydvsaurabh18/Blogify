<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Write New Story — Blogify</title>
</head>
<body>
    <%- include('./partials/nav') %>

    <div class="container my-5">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card p-4 p-md-5" style="background: var(--bg-card); backdrop-filter: blur(16px); border: 1px solid var(--border-color); border-radius: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.4);">
            
            <div class="mb-4 text-center">
              <div class="hero-tag mb-2">
                <i class="bi bi-pencil-fill"></i> Publisher Studio
              </div>
              <h2 class="font-outfit fw-bold text-white">Create a New Article</h2>
              <p class="text-muted">Share your knowledge and ideas with the world.</p>
            </div>

            <form action="/blog" method="post" enctype="multipart/form-data">
              <div class="mb-4">
                <label for="coverImage" class="form-label-custom">Cover Image</label>
                <input type="file" class="form-control form-control-custom" id="coverImage" name="coverImage" required>
                <div class="form-text text-muted mt-1"><i class="bi bi-info-circle me-1"></i> Upload a high-resolution image (.jpg, .png, .webp).</div>
              </div>

              <div class="mb-4">
                <label for="title" class="form-label-custom">Article Title</label>
                <input type="text" class="form-control form-control-custom fs-5" id="title" name="title" placeholder="e.g. Master the Art of Modern Web Design" required>
              </div>

              <div class="mb-4">
                <label for="body" class="form-label-custom">Article Body Content</label>
                <textarea name="body" class="form-control form-control-custom" id="body" rows="10" placeholder="Write your full story here..." required style="min-height: 200px;"></textarea>
              </div>

              <div class="d-flex justify-content-end gap-3 mt-4">
                <a href="/" class="btn btn-outline-custom">Cancel</a>
                <button type="submit" class="btn btn-primary-gradient px-4">
                  <i class="bi bi-send-fill me-1"></i> Publish Article
                </button>
              </div>
            </form>

          </div>
        </div>
      </div>
    </div>

    <%- include('./partials/scripts') %>
</body>
</html>